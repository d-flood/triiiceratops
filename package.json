{
    "name": "triiiceratops-workspace",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/d-flood/triiiceratops.git"
    },
    "homepage": "https://triiiceratops.org/",
    "scripts": {
        "dev": "pnpm --filter @triiiceratops/app-demo dev",
        "dev:lib": "pnpm --filter triiiceratops dev",
        "preview": "pnpm --filter @triiiceratops/app-demo preview",
        "build:lib": "pnpm --filter triiiceratops build:lib",
        "build:element": "pnpm --filter triiiceratops build:element",
        "build:demo": "pnpm --filter @triiiceratops/app-demo build",
        "build:viewer": "pnpm --filter @triiiceratops/app-viewer build",
        "build:examples": "pnpm --filter @triiiceratops/app-examples build",
        "build:packages": "pnpm --filter @triiiceratops/ui build && pnpm --filter triiiceratops build:lib && pnpm --filter @triiiceratops/plugin-sdk build && pnpm --filter '@triiiceratops/plugin-*' --filter '!@triiiceratops/plugin-sdk' build && pnpm --filter triiiceratops build:testing && pnpm --filter triiiceratops build:element && pnpm size:check:pair",
        "build:all": "pnpm build:packages && pnpm --filter './apps/*' build",
        "build:plugin-sdk": "pnpm --filter @triiiceratops/plugin-sdk build",
        "check": "pnpm -r check",
        "test": "pnpm -r test",
        "test:e2e": "pnpm -r --sequential test:e2e",
        "test:packed": "node test-consumers/driver/run.mjs",
        "view:fixture": "node test-consumers/driver/view-fixture.mjs",
        "test:coverage": "pnpm -r --sequential test:coverage",
        "coverage:check": "node scripts/coverage-check.mjs",
        "coverage:baseline": "node scripts/coverage-check.mjs --update",
        "size:check": "node scripts/size-check.mjs",
        "size:check:pair": "node scripts/size-check.mjs --require-pair",
        "size:baseline": "node scripts/size-check.mjs --update",
        "coverage:changed": "node scripts/coverage-changed-lines.mjs",
        "audit:prod": "node scripts/audit-prod.mjs",
        "perf:compare": "node scripts/perf/compare.mjs",
        "perf:measure": "node scripts/perf/measure.mjs",
        "api:report": "node scripts/api-report.ts",
        "api:check": "node scripts/check-public-api.mjs",
        "docs:examples": "node scripts/docs-examples.mjs",
        "docs:examples:check": "node scripts/docs-examples.mjs --check",
        "docs:content-state": "node scripts/docs-content-state.mjs",
        "docs:content-state:check": "node scripts/docs-content-state.mjs --check",
        "docs:recipes": "node scripts/docs-recipes.mjs",
        "docs:recipes:check": "node scripts/docs-recipes.mjs --check",
        "docs:build": "node scripts/docs-examples.mjs --check && node scripts/docs-content-state.mjs --check && node scripts/docs-recipes.mjs --check && node scripts/docs-build.mjs",
        "docs:publish": "node scripts/docs-publish.mjs",
        "urls:check": "node scripts/url-contract.mjs",
        "prepare": "simple-git-hooks",
        "lint": "pnpm -r lint",
        "lint:fix": "pnpm -r lint:fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "changeset": "changeset",
        "release:pack": "node scripts/release/pack-artifacts.mjs",
        "release:reproducible": "node scripts/release/verify-reproducible.mjs",
        "release:smoke": "node scripts/release/smoke-registry.mjs"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.8",
        "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
        "@eslint/js": "^9.39.2",
        "@vitest/coverage-v8": "4.0.15",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.14.0",
        "globals": "^17.1.0",
        "prettier": "^3.7.4",
        "prettier-plugin-svelte": "^3.4.0",
        "simple-git-hooks": "^2.13.1",
        "svelte": "^5.43.8",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.53.1"
    },
    "simple-git-hooks": {
        "pre-commit": "bash scripts/pre-commit.sh"
    }
}
