{
    "name": "triiiceratops-workspace",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/d-flood/triiiceratops.git"
    },
    "homepage": "https://triiiceratops.org/",
    "scripts": {
        "dev": "pnpm --filter @triiiceratops/app-site dev",
        "dev:examples": "pnpm --filter @triiiceratops/app-examples dev",
        "dev:site": "pnpm --filter @triiiceratops/app-site dev",
        "dev:lib": "pnpm --filter triiiceratops dev",
        "site": "node scripts/site.mjs",
        "cms": "node scripts/cms.mjs",
        "site:preview": "pnpm build:all && node apps/site/scripts/serve-published.mjs --root apps/site/build --port 4190",
        "site:serve": "node apps/site/scripts/serve-published.mjs --root apps/site/build --port 4190",
        "preview": "pnpm --filter @triiiceratops/app-site preview",
        "build:lib": "pnpm --filter triiiceratops build:lib",
        "build:element": "pnpm --filter triiiceratops build:element",
        "build:examples": "pnpm --filter @triiiceratops/app-examples build",
        "build:site": "pnpm --filter @triiiceratops/app-site build",
        "build:uncial": "pnpm --filter uncial --filter uncial-cms package",
        "build:packages": "pnpm build:uncial && pnpm --filter @triiiceratops/ui build && pnpm --filter triiiceratops build:lib && pnpm --filter @triiiceratops/plugin-sdk build && pnpm --filter '@triiiceratops/plugin-*' --filter '!@triiiceratops/plugin-sdk' build && pnpm --filter triiiceratops build:testing && pnpm --filter triiiceratops build:element && pnpm size:check:pair",
        "build:all": "pnpm build:packages && pnpm --filter './apps/*' build",
        "build:plugin-sdk": "pnpm --filter @triiiceratops/plugin-sdk build",
        "check": "node scripts/assert-no-nested-store.mjs && pnpm -r --filter './packages/*' --filter './apps/*' check",
        "check:uncial": "node scripts/assert-no-nested-store.mjs && pnpm -r --filter './vendor/uncial/packages/*' check",
        "test": "node scripts/assert-no-nested-store.mjs && pnpm -r --filter './packages/*' --filter './apps/*' test",
        "test:uncial": "node scripts/assert-no-nested-store.mjs && pnpm -r --filter './vendor/uncial/packages/*' test",
        "test:e2e": "pnpm -r --filter './packages/*' --filter './apps/*' --sequential test:e2e",
        "test:packed": "node test-consumers/driver/run.mjs",
        "view:fixture": "node test-consumers/driver/view-fixture.mjs",
        "test:coverage": "pnpm -r --filter './packages/*' --filter './apps/*' --sequential test:coverage",
        "coverage:check": "node scripts/coverage-check.mjs",
        "coverage:baseline": "node scripts/coverage-check.mjs --update",
        "size:check": "node scripts/size-check.mjs",
        "size:check:pair": "node scripts/size-check.mjs --require-pair",
        "size:baseline": "node scripts/size-check.mjs --update",
        "coverage:changed": "node scripts/coverage-changed-lines.mjs",
        "audit:prod": "node scripts/audit-prod.mjs",
        "perf:compare": "node scripts/perf/compare.mjs",
        "perf:measure": "node scripts/perf/measure.mjs",
        "api:report": "node scripts/api-report.ts",
        "api:check": "node scripts/check-public-api.mjs",
        "docs:examples": "node scripts/docs-examples.mjs",
        "docs:examples:check": "node scripts/docs-examples.mjs --check",
        "docs:content-state": "node scripts/docs-content-state.mjs",
        "docs:content-state:check": "node scripts/docs-content-state.mjs --check",
        "docs:build": "node scripts/docs-examples.mjs --check && node scripts/docs-content-state.mjs --check",
        "urls:check": "node scripts/url-contract.mjs",
        "links:check": "pnpm --filter @triiiceratops/app-site links:check",
        "prepare": "simple-git-hooks && node scripts/setup-submodule.mjs && pnpm build:uncial",
        "lint": "pnpm -r --filter './packages/*' --filter './apps/*' lint",
        "lint:fix": "pnpm -r --filter './packages/*' --filter './apps/*' lint:fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "changeset": "changeset",
        "release:pack": "node scripts/release/pack-artifacts.mjs",
        "release:reproducible": "node scripts/release/verify-reproducible.mjs",
        "release:smoke": "node scripts/release/smoke-registry.mjs"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.8",
        "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
        "@eslint/js": "^9.39.2",
        "@vitest/coverage-v8": "4.0.15",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.14.0",
        "globals": "^17.1.0",
        "prettier": "^3.7.4",
        "prettier-plugin-svelte": "^3.4.0",
        "simple-git-hooks": "^2.13.1",
        "svelte": "^5.56.10",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.53.1",
        "uncial": "workspace:*",
        "uncial-cms": "workspace:*"
    },
    "simple-git-hooks": {
        "pre-commit": "bash scripts/pre-commit.sh"
    }
}
