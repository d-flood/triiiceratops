{
    "name": "triiiceratops-workspace",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/d-flood/triiiceratops.git"
    },
    "homepage": "https://d-flood.github.io/triiiceratops/",
    "scripts": {
        "build:lib": "pnpm --filter triiiceratops build:lib",
        "build:element": "pnpm --filter triiiceratops build:element",
        "build:plugins-iife": "pnpm --filter triiiceratops build:plugins-iife",
        "build:demo": "pnpm --filter triiiceratops build:demo",
        "build:svelte-demo": "pnpm --filter triiiceratops build:svelte-demo",
        "build:consumer": "pnpm --filter triiiceratops build:consumer",
        "build:webcomponent-demo": "pnpm --filter triiiceratops build:webcomponent-demo",
        "build:all": "pnpm --filter triiiceratops build:all && pnpm --filter @triiiceratops/plugin-sdk build",
        "build:plugin-sdk": "pnpm --filter @triiiceratops/plugin-sdk build",
        "check": "pnpm --filter triiiceratops check && pnpm --filter @triiiceratops/plugin-sdk check",
        "test": "pnpm --filter triiiceratops test && pnpm --filter @triiiceratops/plugin-sdk test",
        "test:e2e": "pnpm --filter triiiceratops test:e2e",
        "test:packed": "node test-consumers/driver/run.mjs",
        "lint": "pnpm --filter triiiceratops lint",
        "lint:fix": "pnpm --filter triiiceratops lint:fix",
        "format": "pnpm --filter triiiceratops format",
        "format:check": "pnpm --filter triiiceratops format:check",
        "changeset": "changeset"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.8",
        "@eslint/js": "^9.39.2",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.14.0",
        "globals": "^17.1.0",
        "prettier": "^3.7.4",
        "prettier-plugin-svelte": "^3.4.0",
        "svelte": "^5.43.8",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.53.1"
    },
    "pnpm": {
        "overrides": {
            "lodash@>=4.0.0 <4.18.0": ">=4.18.0",
            "qs@<6.15.2": ">=6.15.2",
            "uuid@>=13.0.0 <13.0.1": "^13.0.1",
            "devalue@<5.6.4": ">=5.6.4"
        }
    }
}
