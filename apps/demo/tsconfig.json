{
    "extends": "@tsconfig/svelte/tsconfig.json",
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["svelte", "vite/client", "node"],
        "noEmit": true,
        "strict": true,
        "noImplicitAny": true,
        "allowJs": true,
        "checkJs": false,
        "moduleDetection": "force",
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
