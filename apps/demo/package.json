{
    "name": "@triiiceratops/app-demo",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "description": "The Triiiceratops playground. A private workspace application that consumes the viewer only through its published entrypoints; never published.",
    "license": "MIT",
    "author": "David Flood",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/d-flood/triiiceratops.git",
        "directory": "apps/demo"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix --max-warnings 0"
    },
    "dependencies": {
        "@triiiceratops/config": "workspace:*",
        "@triiiceratops/cookbook": "workspace:*",
        "@triiiceratops/plugin-annotation-editor": "workspace:*",
        "@triiiceratops/plugin-av": "workspace:*",
        "@triiiceratops/plugin-image-export": "workspace:*",
        "@triiiceratops/plugin-image-manipulation": "workspace:*",
        "@triiiceratops/plugin-pdf-export": "workspace:*",
        "triiiceratops": "workspace:*"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@tsconfig/svelte": "^5.0.6",
        "@types/node": "^24.10.1",
        "@vitest/coverage-v8": "4.0.15",
        "eslint": "^9.39.2",
        "svelte": "^5.43.8",
        "jsdom": "^27.3.0",
        "svelte-check": "^4.3.4",
        "typescript": "~5.9.3",
        "vite": "^6.0.0",
        "vitest": "^4.0.15"
    }
}
