{
    "name": "@triiiceratops/app-viewer",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "description": "The bare content-state viewer published at /viewer/. A private workspace application that consumes the viewer only through its published entrypoints; never published.",
    "license": "MIT",
    "author": "David Flood",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/d-flood/triiiceratops.git",
        "directory": "apps/viewer"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
        "test:e2e": "playwright test",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix --max-warnings 0"
    },
    "dependencies": {
        "@triiiceratops/plugin-av": "workspace:*",
        "@triiiceratops/plugin-image-manipulation": "workspace:*",
        "triiiceratops": "workspace:*"
    },
    "devDependencies": {
        "@playwright/test": "^1.57.0",
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@tsconfig/svelte": "^5.0.6",
        "@types/node": "^24.10.1",
        "eslint": "^9.39.2",
        "svelte": "^5.43.8",
        "svelte-check": "^4.3.4",
        "typescript": "~5.9.3",
        "vite": "^6.0.0"
    }
}
