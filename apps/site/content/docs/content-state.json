{
	"type": "doc",
	"version": 2,
	"content": [
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "A "
				},
				{
					"type": "text",
					"text": "content state",
					"marks": [
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": " is a portable IIIF description of a view: either a bare IIIF URI, or a "
				},
				{
					"type": "text",
					"text": "W3C Annotation",
					"marks": [
						{
							"type": "link",
							"attrs": {
								"href": "https://www.w3.org/TR/annotation-model/"
							}
						}
					]
				},
				{
					"type": "text",
					"text": " with "
				},
				{
					"type": "text",
					"text": "motivation: contentState",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " whose "
				},
				{
					"type": "text",
					"text": "target",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " names a Canvas — optionally with an "
				},
				{
					"type": "text",
					"text": "#xywh=",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " region or a "
				},
				{
					"type": "text",
					"text": "#t=",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " media time — and whose "
				},
				{
					"type": "text",
					"text": "partOf",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " names the Manifest. It says "
				},
				{
					"type": "text",
					"text": "what to show",
					"marks": [
						{
							"type": "italic"
						}
					]
				},
				{
					"type": "text",
					"text": ". It says nothing about how it reached you."
				}
			],
			"attrs": {
				"id": "89217622-0100-4c66-90fa-5e1e92320534"
			}
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The "
				},
				{
					"type": "text",
					"text": "iiif-content",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " request parameter is one delivery channel for it. So are a paste, a drop, a "
				},
				{
					"type": "text",
					"text": "FileReader",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", and a "
				},
				{
					"type": "text",
					"text": "data-*",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " attribute. The channel is yours: the viewer never reaches for one on its own, because a component that claimed the address bar could hijack your routing or consume an "
				},
				{
					"type": "text",
					"text": "iiif-content",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " parameter meant for the page around it ("
				},
				{
					"type": "text",
					"text": "ADR 0006",
					"marks": [
						{
							"type": "link",
							"attrs": {
								"href": "https://github.com/d-flood/triiiceratops/blob/main/docs/adr/0006-content-state-is-an-explicit-component-input.md"
							}
						}
					]
				},
				{
					"type": "text",
					"text": "). What it will do is accept the payload from you, on the "
				},
				{
					"type": "text",
					"text": "content-state",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " input — and, if you say so explicitly, read that one parameter on your behalf."
				}
			],
			"attrs": {
				"id": "fc5451e3-3af3-444a-a7a6-69e5a6db1815"
			}
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "You can also skip the viewer entirely. "
				},
				{
					"type": "text",
					"text": "parseContentState",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " turns a content state into a "
				},
				{
					"type": "text",
					"text": "view target",
					"marks": [
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": " — "
				},
				{
					"type": "text",
					"text": "{ manifestId, canvasId?, region?, time? }",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " — which you map onto whatever inputs you like."
				}
			],
			"attrs": {
				"id": "d97447d4-b790-4ce9-987a-d224c1f159be"
			}
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts",
				"id": "85f781e0-07f0-479f-8569-08cf40552ee4"
			},
			"content": [
				{
					"type": "text",
					"text": "import { parseContentState } from 'triiiceratops';\n\nconst param = new URLSearchParams(location.search).get('iiif-content');\nconst target = param ? parseContentState(param) : null;\n\n// Your own routing wins — the URL parameter is the fallback, not the authority.\nif (target) {\n    console.log(target.manifestId, target.canvasId, target.region);\n}"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "parseContentState",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " is pure and fetches nothing. A bare URI comes back as the "
				},
				{
					"type": "text",
					"text": "manifestId",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " for you to dereference; it is never dereferenced here. The viewer, "
				},
				{
					"type": "text",
					"text": "given the same URI",
					"marks": [
						{
							"type": "link",
							"attrs": {
								"href": "#passing-one-to-the-viewer"
							}
						}
					]
				},
				{
					"type": "text",
					"text": ", does dereference it."
				}
			],
			"attrs": {
				"id": "3473d639-a656-4e67-8aee-05edb7faafc5"
			}
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "passing-one-to-the-viewer",
				"id": "fab85805-f75f-4ad6-aeba-c18a8afe2d42"
			},
			"content": [
				{
					"type": "text",
					"text": "Passing one to the viewer"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Two inputs, on every distribution — the Svelte component, the custom element, and the React and Vue wrappers:"
				}
			],
			"attrs": {
				"id": "7ce53d36-758d-4e03-8364-15521cda2f42"
			}
		},
		{
