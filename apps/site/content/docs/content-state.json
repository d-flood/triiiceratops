			}
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "content-state",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " takes a content state in any of its forms: a bare IIIF URI, the Annotation as JSON, or that Annotation base64url-encoded exactly as the "
				},
				{
					"type": "text",
					"text": "iiif-content",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " parameter delivers it."
				}
			],
			"attrs": {
				"id": "ed84a836-b515-47a1-8c8c-412d86abc7b9"
			}
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "html",
				"id": "485d9434-f6e7-42f1-94d5-fdec0d609378"
			},
			"content": [
				{
					"type": "text",
					"text": "<triiiceratops-viewer content-state=\"https://example.org/state/1\">\n</triiiceratops-viewer>"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "read-content-state-from-url",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " delegates one channel — the "
				},
				{
					"type": "text",
					"text": "iiif-content",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " parameter — to the viewer. It is a boolean attribute: presence opts in. It is "
				},
				{
					"type": "text",
					"text": "off by default",
					"marks": [
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": ", it is read "
				},
				{
					"type": "text",
					"text": "once on mount",
					"marks": [
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": ", and the viewer never writes to the address bar, so URL cleanup and re-navigation in a single-page application stay yours."
				}
			],
			"attrs": {
				"id": "61c96a82-b453-4955-b242-fc82eaaf578f"
			}
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "html",
				"id": "df322571-c3bd-4894-be92-bc0dc4dff7dc"
			},
			"content": [
				{
					"type": "text",
					"text": "<triiiceratops-viewer read-content-state-from-url></triiiceratops-viewer>"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "\"Once on mount\" is literal: the flag is read on the viewer's first render, so it has to be set "
				},
				{
					"type": "text",
					"text": "before",
					"marks": [
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": " the element is inserted into the document. Adding the attribute to a viewer that is already mounted does nothing, and never will — there is no second read to catch it. Build the element with the attribute (or render it with the prop) rather than setting it afterwards."
				}
			],
			"attrs": {
				"id": "d25ef424-3c20-4cb7-9e81-dfb5b71f326d"
			}
		},
		{
			"type": "heading",
			"attrs": {
				"level": 3,
				"slug": "precedence",
				"id": "4712e0ea-1f63-4cd6-b4a8-fcbc406b7198"
			},
			"content": [
				{
					"type": "text",
					"text": "Precedence"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "When more than one source is present:"
				}
			],
			"attrs": {
				"id": "6547fe9d-43e6-4e82-a513-242b5d56a92b"
			}
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "plaintext",
				"id": "3c03658a-dd98-4326-ac8a-e0778194756d"
			},
			"content": [
				{
					"type": "text",
					"text": "manifest-id / manifest-json (+ canvas-id, initial-canvas-region)\n  > content-state\n  > the iiif-content URL parameter"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The discrete inputs are the manual-driving API and win. The URL is ambient and lowest-trust. Setting "
				},
				{
					"type": "text",
					"text": "manifest-id",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " therefore turns a content state into a no-op rather than a conflict — which is what lets an application keep its own routing and still opt into the parameter as a fallback."
				}
			],
			"attrs": {
				"id": "f58b05c8-c3db-4fd6-817b-b14293e83db4"
			}
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The tier wins input by input, not just as a whole: a content state still opens its manifest when you set only "
				},
				{
					"type": "text",
					"text": "canvas-id",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " or only "
				},
				{
					"type": "text",
					"text": "initial-canvas-region",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", but the canvas and the region you set are the ones honored, and the target's own canvas or "
				},
				{
					"type": "text",
					"text": "#xywh",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " is dropped."
				}
			],
			"attrs": {
				"id": "c0ba5471-946f-4449-bb63-3ef1405e298b"
			}
		},
		{
			"type": "heading",
			"attrs": {
				"level": 3,
				"slug": "dereferencing-a-uri",
				"id": "8f79bf48-b980-47a0-b2be-bb0251c99621"
			},
			"content": [
				{
					"type": "text",
					"text": "Dereferencing a URI"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "A content state that is a bare URI is fetched, and the document that comes back is parsed — so the URI form works whether it points at a content-state Annotation or straight at a Manifest. The request goes through the same fetch path "
				},
				{
					"type": "text",
					"text": "manifest-id",
					"marks": [
						{
