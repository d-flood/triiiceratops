					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "A "
								},
								{
									"type": "text",
									"text": "partOf",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": " array resolves the first entry whose type is "
