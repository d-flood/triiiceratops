	"content": [
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Provides brightness, contrast, saturation, invert, and grayscale controls for the displayed image. It renders as a compact "
				},
				{
					"type": "text",
					"text": "flyout",
					"marks": [
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": " that grows out of its toolbar button — three bare vertical sliders (brightness/contrast/saturation) plus invert/grayscale toggles and a reset button, all visible and interactable at once, floating directly over the canvas with no container box."
				}
			],
			"attrs": {
				"id": "a47eb055-7eda-4253-9ad4-772c3be476a2"
			}
		},
