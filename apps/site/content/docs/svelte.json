		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "triiiceratops/svelte",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " is the "
				},
				{
					"type": "text",
					"text": "native",
					"marks": [
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": " Svelte 5 component — no custom element, no wrapper layer. Core ships the viewer as a source-distributed component, so your application compiles it inside its own Svelte runtime: it tree-shakes normally and never bundles a second copy of Svelte."
				}
			],
			"attrs": {
				"id": "05d5261c-66d0-4376-8323-3437eeac4986"
			}
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "This is also the only entry point that needs the optional "
				},
				{
					"type": "text",
					"text": "svelte",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " peer installed. It is a superset of the root entry — everything "
				},
				{
					"type": "text",
					"text": "triiiceratops",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " exports is re-exported here, so a Svelte app imports from this one specifier and nothing else."
				}
			],
			"attrs": {
				"id": "9e8bb953-0ef2-44ba-b402-e35ee2f5de57"
			}
		},
