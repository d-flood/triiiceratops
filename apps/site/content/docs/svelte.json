		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "your-first-viewer",
				"id": "0b7a6d59-3e3e-4e17-8ef0-ba2d9ae9149a"
			},
			"content": [
				{
					"type": "text",
					"text": "Your first viewer"
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "html",
				"id": "ec31dd48-ae5d-4f3f-99ca-56cde9ae06b6"
			},
			"content": [
				{
					"type": "text",
					"text": "<script lang=\"ts\">\n    import { TriiiceratopsViewer } from 'triiiceratops/svelte';\n    // Import the design tokens + themes exactly once, anywhere in your app.\n    import 'triiiceratops/style.css';\n</script>\n\n<!-- The container must have a height; the viewer fills it. -->\n<div style=\"height: 600px;\">\n    <TriiiceratopsViewer manifestId=\"https://example.org/manifest.json\" />\n</div>"
				}
			]
		},
		{
			"type": "callout",
			"attrs": {
				"kind": "important",
				"title": "The stylesheet is an explicit import",
				"id": "a8506676-2708-4867-8127-bebe778a4774"
			},
			"content": [
				{
					"type": "paragraph",
					"content": [
						{
							"type": "text",
							"text": "Importing the component adds "
						},
						{
							"type": "text",
							"text": "no",
							"marks": [
								{
									"type": "bold"
								}
							]
						},
						{
							"type": "text",
							"text": " global CSS side effects. Styling comes from the one "
						},
						{
							"type": "text",
							"text": "import 'triiiceratops/style.css'",
							"marks": [
								{
									"type": "code"
								}
							]
						},
						{
							"type": "text",
							"text": ". Every rule in that stylesheet is scoped to the viewer root, so it cannot restyle your host page."
						}
					],
					"attrs": {
						"id": "1f10cd24-2925-4897-b2a6-cf7286abfce5"
					}
				}
			]
		},
		{
			"type": "callout",
			"attrs": {
				"kind": "note",
				"title": "Works in SvelteKit out of the box",
				"id": "927643c3-f12f-4579-934d-5d216737c953"
			},
			"content": [
				{
					"type": "paragraph",
					"content": [
						{
							"type": "text",
							"text": "Bundler-neutral (no "
						},
						{
							"type": "text",
							"text": "import.meta.env",
							"marks": [
								{
									"type": "code"
								}
							]
						},
						{
							"type": "text",
							"text": " reliance) and SSR-safe — core server-renders cleanly and initializes the browser-only image renderer only on the client, so it hydrates without mismatch warnings. You do "
						},
						{
							"type": "text",
							"text": "not",
							"marks": [
								{
									"type": "bold"
								}
							]
						},
						{
							"type": "text",
							"text": " need "
						},
						{
							"type": "text",
							"text": "export const ssr = false",
							"marks": [
								{
									"type": "code"
								}
							]
						},
						{
							"type": "text",
							"text": " or a browser-only guard. Import the stylesheet once in your root "
						},
						{
							"type": "text",
							"text": "+layout.svelte",
							"marks": [
								{
									"type": "code"
								}
							]
						},
						{
							"type": "text",
							"text": "."
						}
					],
					"attrs": {
						"id": "0d5d6561-b1dc-4741-9663-dfeed023cbe8"
					}
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "reading-and-commanding-state",
				"id": "790193bd-5b4e-4fec-9f18-edbe02501820"
			},
			"content": [
				{
					"type": "text",
					"text": "Reading and commanding state"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Svelte needs no handle abstraction and no selector API. "
				},
				{
					"type": "text",
					"text": "ViewerState",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " is a rune class, so its members are already reactive: read them in your markup or in a "
				},
				{
					"type": "text",
					"text": "$derived",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " and Svelte tracks the dependency for you. There are two ways to get the instance."
				}
			],
			"attrs": {
				"id": "b53d8f4c-744d-4839-bad3-451178f75dd0"
			}
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "bind:viewerState",
					"marks": [
						{
							"type": "code"
						},
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": " — when the state belongs to this component:"
				}
			],
			"attrs": {
				"id": "d56260e4-9899-4ee8-a5e1-9551921dfe1b"
			}
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "html",
				"id": "7376c2b0-b4b9-4302-86d6-d82059c21aee"
			},
			"content": [
				{
					"type": "text",
					"text": "<script lang=\"ts\">\n    import { TriiiceratopsViewer, type ViewerState } from 'triiiceratops/svelte';\n    import 'triiiceratops/style.css';\n\n    let viewerState = $state<ViewerState | undefined>();\n\n    // Reactive: recomputes when the viewer navigates.\n    const canvasId = $derived(viewerState?.canvasId ?? 'No canvas yet');\n</script>\n\n<p>{canvasId}</p>\n<button onclick={() => viewerState?.nextCanvas()}>Next canvas</button>\n\n<div style=\"height: 600px;\">\n    <TriiiceratopsViewer\n        bind:viewerState\n        manifestId=\"https://example.org/manifest.json\"\n    />\n</div>"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "getContext(VIEWER_STATE_KEY)",
					"marks": [
						{
							"type": "code"
						},
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": " — inside any descendant, with no prop threading:"
				}
			],
			"attrs": {
				"id": "b1718cad-27b7-486b-95c5-f592545443dd"
			}
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "html",
				"id": "6753bc7c-39d4-4083-a68d-6ee52ba247a8"
			},
			"content": [
				{
					"type": "text",
					"text": "<script lang=\"ts\">\n    import { getContext } from 'svelte';\n    import { VIEWER_STATE_KEY, type ViewerState } from 'triiiceratops/svelte';\n\n    const state = getContext<ViewerState>(VIEWER_STATE_KEY);\n</script>\n\n<span>{state.currentCanvasIndex + 1} / {state.sequenceCount}</span>"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The component sets that context, so this is the same instance "
				},
				{
					"type": "text",
					"text": "bind:viewerState",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " exposes — the one the plugin SDK and every other host read. "
				},
				{
					"type": "text",
					"text": "ViewerState",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " is per-viewer: two viewers on a page are two independent instances."
				}
			],
			"attrs": {
				"id": "e50d3af2-417b-4a93-ab89-19c4fec24dd5"
			}
		},
		{
			"type": "callout",
			"attrs": {
				"kind": "tip",
				"title": "`undefined` until the viewer mounts",
				"id": "43a601ba-b5b3-42b4-a697-244ad7b48899"
			},
			"content": [
				{
					"type": "paragraph",
					"content": [
						{
							"type": "text",
							"text": "bind:viewerState",
							"marks": [
								{
									"type": "code"
								}
							]
						},
						{
							"type": "text",
							"text": " is populated when the component mounts its viewer, so the bound variable is "
						},
						{
							"type": "text",
							"text": "undefined",
							"marks": [
								{
									"type": "code"
								}
							]
						},
						{
							"type": "text",
							"text": " for the first tick. "
						},
						{
							"type": "text",
							"text": "$derived",
							"marks": [
								{
									"type": "code"
								}
							]
						},
						{
							"type": "text",
							"text": " plus "
						},
						{
							"type": "text",
							"text": "?.",
							"marks": [
								{
									"type": "code"
								}
							]
						},
						{
							"type": "text",
							"text": ", as above, is the whole pattern."
						}
					],
					"attrs": {
						"id": "c9684ba7-f1aa-41b9-ae2f-748c5d508df7"
					}
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The framework-neutral "
				},
				{
					"type": "text",
					"text": "triiiceratops/selectors",
					"marks": [
						{
							"type": "code"
						},
						{
							"type": "link",
							"attrs": {
								"href": "/docs/configuration/"
							}
						}
					]
				},
				{
					"type": "text",
					"text": " runtime exists for hosts that need memoized, equality-gated projections. Svelte's reactivity already does that work, so you do not need it here."
				}
			],
			"attrs": {
				"id": "d8ed374c-a81c-4a8f-8bad-8f1cb41efaeb"
			}
		},
