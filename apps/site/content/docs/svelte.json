		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Plain Svelte props — objects and functions pass straight through, so none of the attribute-versus-property care the custom element needs applies. "
				},
				{
					"type": "text",
					"text": "manifestId",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " and "
				},
				{
					"type": "text",
					"text": "canvasId",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " are "
				},
				{
					"type": "text",
					"text": "uncontrolled",
					"marks": [
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": ": one-way instructions to the viewer, not enforced bindings. Re-asserting the current "
				},
				{
					"type": "text",
					"text": "canvasId",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " writes nothing, so your markup never fights a user who navigated internally; read "
				},
				{
					"type": "text",
					"text": "viewerState",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " to follow where the viewer actually is."
				}
			],
			"attrs": {
				"id": "e32bab59-68b0-4173-b800-2ee55c816868"
			}
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "errors",
				"id": "41faefa7-f6f0-41a0-8b00-ed2c8b5a8131"
			},
			"content": [
				{
					"type": "text",
					"text": "Errors"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The two callback props receive the same structured objects the custom element dispatches as "
				},
				{
					"type": "text",
					"text": "pluginerror",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " and "
				},
				{
					"type": "text",
					"text": "viewererror",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " events:"
				}
			],
			"attrs": {
				"id": "bd7f77da-dc3b-44fd-b255-7be1e2e8fa2a"
			}
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "html",
				"id": "40a1c103-dcf3-4448-b67e-9b13300b72cf"
			},
			"content": [
				{
					"type": "text",
					"text": "<script lang=\"ts\">\n    import { TriiiceratopsViewer } from 'triiiceratops/svelte';\n    import 'triiiceratops/style.css';\n</script>\n\n<TriiiceratopsViewer\n    manifestId=\"https://example.org/manifest.json\"\n    onpluginerror={(error) => console.warn(error.pluginName, error.phase)}\n    onviewererror={(error) => console.error(error.code, error.message)}\n/>"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "PluginError",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " carries a "
				},
				{
					"type": "text",
					"text": "retry()",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", so a host can offer the user a second attempt rather than only reporting the failure."
				}
			],
			"attrs": {
				"id": "bf6eb153-d316-4b4a-9f8a-a39b70a8c3d5"
			}
		},
		{
			"type": "heading",
			"attrs": {
