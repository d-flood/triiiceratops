							}
						},
						{
							"type": "tableCell",
							"content": [
								{
									"type": "paragraph",
									"content": [
										{
											"type": "text",
											"text": "Shadow DOM",
											"marks": [
												{
													"type": "link",
													"attrs": {
														"href": "#shadow-dom-custom-element"
													}
												}
											]
										}
									],
									"attrs": {
