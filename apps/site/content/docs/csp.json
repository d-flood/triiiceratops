			"content": [
				{
					"type": "text",
					"text": "CI runs CSP packed-consumer fixtures under a realistic strict policy (no "
				},
				{
					"type": "text",
					"text": "unsafe-eval",
					"marks": [
						{
							"type": "code"
						}
