{
	"type": "doc",
	"version": 2,
	"content": [
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Triiiceratops runs under a strict Content Security Policy. It does "
				},
				{
					"type": "text",
					"text": "not",
					"marks": [
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": " require "
				},
				{
					"type": "text",
					"text": "unsafe-eval",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", and it does not require "
				},
				{
					"type": "text",
					"text": "unsafe-inline",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " for scripts. Runtime styles (the plugin/global style service) prefer constructable stylesheets ("
				},
				{
					"type": "text",
					"text": "adoptedStyleSheets",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": "), which need no inline "
				},
				{
					"type": "text",
					"text": "<style>",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " and are CSP-friendly by default. The service falls back to a "
				},
				{
					"type": "text",
					"text": "<style>",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " element — carrying your CSP "
				},
				{
					"type": "text",
					"text": "nonce",
					"marks": [
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": " — whenever constructable stylesheets are unavailable, "
				},
				{
					"type": "text",
					"text": "or",
					"marks": [
						{
							"type": "italic"
						}
					]
				},
				{
					"type": "text",
					"text": " whenever the host advertises a nonce at all (nonces cannot attach to constructable stylesheets, so advertising one always opts back into the "
				},
				{
					"type": "text",
					"text": "<style>",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " path)."
				}
			],
			"attrs": {
				"id": "e4da9952-b5a3-4107-944e-943bc43466ed"
			}
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The viewer itself also uses inline "
				},
				{
					"type": "text",
					"text": "style=\"…\"",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " attributes for dynamic layout (panel widths, positioning, and similar). A nonce does not cover style "
				},
				{
					"type": "text",
					"text": "attributes",
					"marks": [
						{
							"type": "italic"
						}
					]
				},
				{
					"type": "text",
					"text": " — only "
				},
				{
					"type": "text",
					"text": "'unsafe-inline'",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " does — so every policy below allows those explicitly via "
				},
				{
					"type": "text",
					"text": "style-src-attr",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": "."
				}
			],
			"attrs": {
				"id": "7b944fc3-7d03-4d38-935b-7946d5035c6a"
			}
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The two distributions need slightly different policies, because only the light-DOM Svelte package's component styles are nonce-addressable."
				}
			],
			"attrs": {
				"id": "474a67a4-e315-4ffb-a9a3-1f5c219b169c"
			}
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Which recipe applies to you?",
					"marks": [
						{
							"type": "bold"
						}
					]
				}
			],
			"attrs": {
				"id": "55882b1d-0f20-4993-a6cc-80f2146ca2b8"
			}
		},
