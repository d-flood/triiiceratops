		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts",
				"id": "ea302738-339d-43cc-8a64-7e100674b12a"
			},
			"content": [
				{
					"type": "text",
					"text": "import 'triiiceratops/element/register';\nimport type { TriiiceratopsViewerElement } from 'triiiceratops';\n\n// The published element type declares the state bridge (`viewerState`) and\n// `searchProvider`. TypeScript hosts widen it locally with the other\n// property-tier inputs they assign; those exist on the element at runtime.\ntype ViewerHost = TriiiceratopsViewerElement & {\n    manifestJson?: string | object;\n    themeConfig?: string | object;\n    config?: string | object;\n    initialCanvasRegion?: string | object;\n    plugins?: readonly unknown[];\n};\n\nconst el = document.querySelector<ViewerHost>('triiiceratops-viewer')!;\n\nel.setAttribute('manifest-id', 'https://example.org/manifest.json');\nel.config = { toolbar: { side: 'right' } };\n\nel.addEventListener('canvaschange', (event) => {\n    const snapshot = (event as CustomEvent).detail;\n    console.log('canvas is now', snapshot.canvasId);\n});"
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 3,
				"slug": "the-state-bridge",
				"id": "8e3569d5-b2c6-485c-be75-e4fb2905ba1d"
			},
			"content": [
				{
					"type": "text",
					"text": "The state bridge"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The element exposes the owning viewer's live per-instance "
				},
				{
					"type": "text",
					"text": "ViewerState",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " — the same object plugins and framework wrappers read — through a "
				},
				{
					"type": "text",
					"text": "getter-only",
					"marks": [
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": " "
				},
				{
					"type": "text",
					"text": "viewerState",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " property, paired with a "
				},
				{
					"type": "text",
					"text": "viewerstateavailable",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " event:"
				}
			],
			"attrs": {
				"id": "f21616bf-4e18-4953-9b44-8f533505f520"
			}
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts",
				"id": "04aff679-a2f6-40b2-ab70-d3b221c815a4"
			},
			"content": [
				{
					"type": "text",
					"text": "import 'triiiceratops/element/register';\nimport type { TriiiceratopsViewerElement } from 'triiiceratops';\n\nconst el = document.querySelector<TriiiceratopsViewerElement>(\n    'triiiceratops-viewer',\n)!;\n\nfunction bind(state: NonNullable<TriiiceratopsViewerElement['viewerState']>) {\n    // Read on demand…\n    console.log(state.canvasId);\n    // …command it…\n    state.nextCanvas();\n    // …or subscribe. Notifications are batched and carry no payload: they mean\n    // \"state changed — read what you need\".\n    return state.subscribe(() => console.log('now at', state.canvasId));\n}\n\n// Listen THEN check: this catches state that becomes available before, during,\n// or after this code runs, with no race and no polling.\nel.addEventListener('viewerstateavailable', (event) => {\n    bind((event as CustomEvent).detail);\n});\nif (el.viewerState) bind(el.viewerState);"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Notes on the bridge:"
				}
			],
			"attrs": {
				"id": "6a9aed62-c30a-464f-ae39-aae474e17a0e"
			}
		},
		{
			"type": "bulletList",
			"content": [
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "viewerState",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": " is "
								},
								{
									"type": "text",
									"text": "undefined",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": " before the inner viewer mounts and again after disconnection, and it is getter-only — a host physically cannot replace it."
								}
							],
							"attrs": {
								"id": "de628147-8fd5-43b8-ac53-3b4cfe88dffa"
							}
						}
					],
					"attrs": {
						"id": "aba0f405-e2b6-496b-97c3-cb49673b043e"
					}
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "viewerstateavailable",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": " means only that state can be bound. It does not mean a manifest has loaded, the renderer is ready, or a requested canvas is visible."
								}
							],
							"attrs": {
								"id": "f4446412-b239-4902-a6b9-10fc4b431417"
							}
						}
					],
					"attrs": {
						"id": "9831c3b0-a68f-479f-949a-f8c1dd4575c5"
					}
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Ordinary state updates do not repeat the event. A disconnection that destroys the inner viewer and a later reconnection produce a "
								},
								{
									"type": "text",
									"text": "new",
									"marks": [
										{
											"type": "bold"
										}
									]
								},
								{
									"type": "text",
									"text": " "
								},
								{
									"type": "text",
									"text": "ViewerState",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": " and a new event; rebind and drop the old one."
								}
							],
							"attrs": {
								"id": "e0e16bfb-e910-4c5c-8fea-a7f51d3417bf"
							}
						}
					],
					"attrs": {
						"id": "e69e7df5-7b94-4665-a01a-0e735ee04010"
					}
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "For memoized, equality-gated reads over this state, "
								},
								{
									"type": "text",
									"text": "triiiceratops/selectors",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": " exports the same framework-neutral selector runtime the wrappers and the plugin SDK use."
								}
							],
							"attrs": {
								"id": "1d5eb415-faf6-40ea-a3f9-c8d90a839c7c"
							}
						}
					],
					"attrs": {
						"id": "178c4636-2194-4c0e-abb3-e8318746f42b"
					}
				}
			],
			"attrs": {
				"id": "6d1c5669-22a6-42ec-975a-ce4ace366e76"
			}
		},
		{
			"type": "heading",
			"attrs": {
				"level": 3,
				"slug": "searchprovider-on-the-element",
				"id": "d4fa7153-1bc9-4435-bb38-64a745224416"
			},
			"content": [
				{
					"type": "text",
					"text": "searchProvider",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " on the element"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "searchProvider",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " is a property-only input — there is no reflected attribute — and it works exactly as it does in the framework wrappers and in Svelte:"
				}
			],
			"attrs": {
				"id": "41bc3b6a-1251-4122-8eea-a6a878e944e0"
			}
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts",
				"id": "60262f1b-2282-4641-a7be-f353c5298fff"
			},
			"content": [
				{
					"type": "text",
					"text": "import 'triiiceratops/element/register';\nimport type { SearchProvider, TriiiceratopsViewerElement } from 'triiiceratops';\n\nconst el = document.querySelector<TriiiceratopsViewerElement>(\n    'triiiceratops-viewer',\n)!;\n\nconst searchProvider: SearchProvider = async (query, context) => [\n    {\n        canvasIndex: 0,\n        canvasLabel: context.canvasId ?? 'Page 1',\n        hits: [{ type: 'hit', match: query }],\n    },\n];\n\nel.searchProvider = searchProvider;"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Set it to "
				},
				{
					"type": "text",
					"text": "null",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " (or leave it unset) to use the viewer's normal IIIF Content Search service discovery."
				}
			],
			"attrs": {
				"id": "c77268d5-5979-4541-b2a3-175e9e3aaa44"
			}
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "hand-wiring-a-component-framework",
				"id": "965f5654-5dc7-4802-a713-22d48561e17f"
			},
			"content": [
				{
					"type": "text",
					"text": "Hand-wiring a component framework"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The two recipes below exist only for hosts that deliberately want the raw element — most often an existing integration mid-migration. New React and Vue code should use the "
				},
				{
					"type": "text",
					"text": "React",
					"marks": [
						{
							"type": "link",
							"attrs": {
								"href": "/docs/react/"
							}
						}
					]
				},
				{
					"type": "text",
					"text": " and "
				},
				{
					"type": "text",
					"text": "Vue",
					"marks": [
						{
							"type": "link",
							"attrs": {
								"href": "/docs/vue/"
							}
						}
					]
				},
				{
					"type": "text",
					"text": " wrappers, which do all of this for you and are the supported path."
				}
			],
			"attrs": {
				"id": "a6b046a4-9e32-4633-84fe-6efdc3d49a2e"
			}
		},
		{
			"type": "heading",
			"attrs": {
				"level": 3,
				"slug": "hand-wiring-react",
				"id": "a22314fd-55b7-4cec-8bcc-536987fa2631"
			},
			"content": [
				{
					"type": "text",
					"text": "Hand-wiring React"
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "jsx",
				"id": "59be96b3-79f7-4d93-a638-194aced3584e"
			},
			"content": [
				{
					"type": "text",
					"text": "import { useEffect, useRef } from 'react';\nimport 'triiiceratops/element/register';\nimport { ImageManipulationPlugin } from '@triiiceratops/plugin-image-manipulation';\n\nexport function Viewer({ manifestId }) {\n    const ref = useRef(null);\n\n    useEffect(() => {\n        const el = ref.current;\n        if (!el) return;\n        el.manifestId = manifestId;\n        el.plugins = [ImageManipulationPlugin];\n        el.config = { toolbar: { side: 'right' } };\n        const onStateChange = (e) => console.log('viewer state', e.detail);\n        el.addEventListener('statechange', onStateChange);\n        return () => el.removeEventListener('statechange', onStateChange);\n    }, [manifestId]);\n\n    return (\n        <triiiceratops-viewer\n            ref={ref}\n            style={{ display: 'block', width: '100%', height: '600px' }}\n        />\n    );\n}"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "TypeScript hosts taking this path must declare the tag in "
				},
				{
					"type": "text",
					"text": "JSX.IntrinsicElements",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " (or set properties through a typed ref, as above) to satisfy the compiler. The wrapper removes that requirement."
				}
			],
			"attrs": {
				"id": "b61be9d8-4688-45ae-92b0-68945d4fdc99"
			}
		},
		{
			"type": "heading",
			"attrs": {
				"level": 3,
				"slug": "hand-wiring-vue",
				"id": "bea33c4f-905b-4e54-acc3-492dafb2bb0f"
			},
			"content": [
				{
					"type": "text",
					"text": "Hand-wiring Vue"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Tell the compiler the tag is a custom element so it does not try to resolve it as a Vue component, then set complex values as properties through a template ref:"
				}
			],
			"attrs": {
				"id": "d6f9f870-9204-47ad-9a01-ee2ebf137a3b"
			}
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts",
				"id": "33c4799b-865b-4291-8050-a5efa56d96e4"
			},
			"content": [
				{
					"type": "text",
					"text": "// vite.config.ts\nvue({\n    template: {\n        compilerOptions: {\n            isCustomElement: (tag) => tag === 'triiiceratops-viewer',\n        },\n    },\n});"
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "vue",
				"id": "f3da1a6f-e490-4e79-a165-3549d83fb202"
			},
			"content": [
				{
					"type": "text",
					"text": "<script setup>\nimport { onMounted, ref, watch } from 'vue';\nimport 'triiiceratops/element/register';\nimport { ImageManipulationPlugin } from '@triiiceratops/plugin-image-manipulation';\n\nconst props = defineProps(['manifestId']);\nconst viewer = ref(null);\n\nfunction sync() {\n    viewer.value.manifestId = props.manifestId;\n    viewer.value.plugins = [ImageManipulationPlugin];\n    viewer.value.config = { toolbar: { side: 'right' } };\n}\n\nonMounted(() => {\n    sync();\n    viewer.value.addEventListener('statechange', (e) => {\n        console.log('viewer state', e.detail);\n    });\n});\nwatch(() => props.manifestId, sync);\n</script>\n\n<template>\n    <triiiceratops-viewer ref=\"viewer\" style=\"display: block; width: 100%; height: 600px\" />\n</template>"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The wrapper removes the "
				},
				{
					"type": "text",
					"text": "isCustomElement",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " configuration, the property assignments, and the manual listeners."
				}
			],
			"attrs": {
				"id": "31f6a9a3-a597-47a0-97bf-1268d6400e4b"
			}
		},
