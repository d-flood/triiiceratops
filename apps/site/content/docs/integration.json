{
	"type": "doc",
	"version": 2,
	"content": [
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Triiiceratops ships the viewer as a standards-based custom element, "
				},
				{
					"type": "text",
					"text": "<triiiceratops-viewer>",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ". If your stack can put a tag on a page, it can host the viewer — no adapter required."
				}
			],
			"attrs": {
				"id": "75ccdf2a-b984-4e4a-ae64-29a2d9b71659"
			}
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "This is your page if you are using",
					"marks": [
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": " Angular, Lit, Solid, Svelte-free vanilla JavaScript, Alpine.js, htmx, Astro, Ember, jQuery, a server-rendered template language (Django, Rails, Laravel, ASP.NET, PHP), a static-site generator, or "
				},
				{
					"type": "text",
					"text": "WordPress",
					"marks": [
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": " — as a block, a shortcode, or a raw HTML widget. Every one of those is the same two steps: get the script onto the page, then set attributes and properties on the tag."
				}
			],
			"attrs": {
				"id": "a9dc66dc-0829-4ab1-b0d3-fa243ee3c5d6"
			}
		},
		{
			"type": "callout",
			"attrs": {
				"kind": "tip",
				"title": "React, Vue, and Svelte have first-class components",
				"id": "549bc79d-d291-4324-acda-b284a894cea4"
			},
			"content": [
				{
					"type": "paragraph",
					"content": [
						{
							"type": "text",
							"text": "Those three have dedicated guides, and you should use them rather than the element directly — each translates props, events, and viewer state into its framework's own idioms:"
						}
					],
					"attrs": {
						"id": "e9814709-65d7-472b-89ed-8b1c97a07b7e"
					}
				},
				{
					"type": "bulletList",
					"content": [
						{
							"type": "listItem",
							"content": [
								{
									"type": "paragraph",
									"content": [
										{
											"type": "text",
											"text": "React guide",
											"marks": [
												{
													"type": "link",
													"attrs": {
														"href": "/docs/react/"
													}
												},
												{
													"type": "bold"
												}
											]
										},
										{
											"type": "text",
											"text": " — "
										},
										{
											"type": "text",
											"text": "triiiceratops/react",
											"marks": [
												{
													"type": "code"
												}
											]
										}
									],
									"attrs": {
										"id": "d76bbd4d-d907-402a-897b-593b3b625923"
									}
								}
							],
							"attrs": {
								"id": "831b0bfd-07cb-4e43-a7cf-3b03797b4a0f"
							}
						},
						{
							"type": "listItem",
							"content": [
								{
									"type": "paragraph",
									"content": [
										{
											"type": "text",
											"text": "Vue guide",
											"marks": [
												{
													"type": "link",
													"attrs": {
														"href": "/docs/vue/"
													}
												},
												{
													"type": "bold"
												}
											]
										},
										{
											"type": "text",
											"text": " — "
										},
										{
											"type": "text",
											"text": "triiiceratops/vue",
											"marks": [
												{
													"type": "code"
												}
											]
										}
									],
									"attrs": {
										"id": "5e31249e-f1f2-4b75-8d69-d67fc2e5bee6"
									}
								}
							],
							"attrs": {
								"id": "64e5141f-b9ff-4231-b510-3c0ae708ca27"
							}
						},
						{
							"type": "listItem",
							"content": [
								{
									"type": "paragraph",
									"content": [
										{
											"type": "text",
											"text": "Svelte guide",
											"marks": [
												{
													"type": "link",
													"attrs": {
														"href": "/docs/svelte/"
													}
												},
												{
													"type": "bold"
												}
											]
										},
										{
											"type": "text",
											"text": " — "
										},
										{
											"type": "text",
											"text": "triiiceratops/svelte",
											"marks": [
												{
													"type": "code"
												}
											]
										}
									],
									"attrs": {
										"id": "3b6ef54f-783f-41c8-919c-d13ca9f38dc8"
									}
								}
							],
							"attrs": {
								"id": "43bba3c1-2779-46b0-8c91-d46482657ff9"
							}
						}
					],
					"attrs": {
						"id": "7c213042-385a-45b5-a302-ec84ad301442"
					}
				},
				{
					"type": "paragraph",
					"content": [
						{
							"type": "text",
							"text": "React and Vue require no Svelte, at runtime or at type-check time. The custom-element material here stays fully supported for hosts that want direct DOM control, including a React or Vue app that deliberately drops down to it — see "
						},
						{
							"type": "text",
							"text": "hand-wiring",
							"marks": [
								{
									"type": "link",
									"attrs": {
										"href": "#hand-wiring-a-component-framework"
									}
								}
							]
						},
						{
							"type": "text",
							"text": "."
						}
					],
					"attrs": {
						"id": "b0c9dd35-3431-4eb4-8573-9d32a39810a6"
					}
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The element comes in two forms:"
				}
			],
			"attrs": {
				"id": "622625e7-a246-4994-86ff-0d5315c3a347"
			}
		},
		{
			"type": "bulletList",
			"content": [
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "ESM registration",
									"marks": [
										{
											"type": "bold"
										}
									]
								},
								{
									"type": "text",
									"text": " ("
								},
								{
									"type": "text",
									"text": "triiiceratops/element/register",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": ") for projects with a bundler (Vite, webpack, Rollup, …)."
								}
							],
							"attrs": {
								"id": "6a80f6d3-9669-4bbc-9a10-0dd3fe331140"
							}
						}
					],
					"attrs": {
						"id": "a2a31f9d-0368-43d2-a1c1-b541c626447b"
					}
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Self-contained IIFE",
									"marks": [
										{
											"type": "bold"
										}
									]
								},
								{
									"type": "text",
									"text": " ("
								},
								{
									"type": "text",
									"text": "triiiceratops/element",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": ") for no-bundler pages loaded from a "
								},
								{
									"type": "text",
									"text": "<script>",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": " tag."
								}
							],
							"attrs": {
								"id": "6e126b5a-93cb-4c94-8e9e-a7b85721ab3f"
							}
						}
					],
					"attrs": {
						"id": "ccba0f24-0c1e-4187-8ba7-b5b9be156c87"
					}
				}
			],
			"attrs": {
				"id": "7aa9e56b-361c-445f-a992-f16799fc9312"
			}
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Both register the "
				},
				{
					"type": "text",
					"text": "same tag",
					"marks": [
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": " and expose the same properties, methods, and events. Styles and themes are installed "
				},
				{
					"type": "text",
					"text": "inside the element's shadow root",
					"marks": [
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": " — there is no separate element stylesheet to import."
				}
			],
			"attrs": {
				"id": "6bded850-9900-4c87-91c3-4d56ccba01b8"
			}
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "install",
				"id": "5dd0a2e0-60b0-4f7d-a821-314e4aa76c81"
			},
			"content": [
				{
					"type": "text",
					"text": "Install"
				}
			]
		},
		{
			"type": "tabs",
			"attrs": {
				"group": "package-manager",
				"id": "e28c3f75-fc61-45f4-8164-ccfb231b939d"
			},
			"content": [
				{
					"type": "tab",
					"attrs": {
						"label": "pnpm",
						"id": "e2979159-e841-4fcb-8338-28f901e8ad68"
					},
					"content": [
						{
							"type": "codeBlock",
							"attrs": {
								"language": "bash",
								"id": "8e75894d-9216-4afe-9d78-27b58598e912"
							},
							"content": [
								{
									"type": "text",
									"text": "pnpm add triiiceratops"
								}
							]
						}
					]
				},
				{
					"type": "tab",
					"attrs": {
						"label": "npm",
						"id": "9f9e5e47-c4fe-4b97-affc-ffdd45b1ae83"
					},
					"content": [
						{
							"type": "codeBlock",
							"attrs": {
								"language": "bash",
								"id": "980a1b64-ceee-4ce0-b7bd-bfb7ef52f89e"
							},
							"content": [
								{
									"type": "text",
									"text": "npm install triiiceratops"
								}
							]
						}
					]
				},
				{
					"type": "tab",
					"attrs": {
						"label": "bun",
						"id": "fabbd6c3-9d7d-4275-9b8a-c64b082d0c84"
					},
					"content": [
						{
							"type": "codeBlock",
							"attrs": {
								"language": "bash",
								"id": "04657783-245d-4456-9d0d-a47f1bf05062"
							},
							"content": [
								{
									"type": "text",
									"text": "bun add triiiceratops"
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "No-bundler pages skip this — see the HTML tab below for loading straight from a CDN "
				},
				{
					"type": "text",
					"text": "<script>",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " tag."
				}
			],
			"attrs": {
				"id": "1a7fa35e-b7e0-4895-b049-34f8c26bd3aa"
			}
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "use-it",
				"id": "ad40614f-d95e-437f-b38e-a0ade996a262"
			},
			"content": [
				{
					"type": "text",
					"text": "Use it"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Load the self-contained IIFE from a CDN or a copied file — no install, no build step. It bundles the element, the Svelte runtime, the image renderer, and all styles:"
				}
			],
			"attrs": {
				"id": "920fbf22-d116-4eb1-af87-b2a6664e4783"
			}
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "html",
				"id": "cc04040d-70ce-4da1-91de-fc7df1e7de52"
			},
			"content": [
				{
					"type": "text",
					"text": "<script src=\"https://unpkg.com/triiiceratops/dist/triiiceratops-element.iife.js\"></script>\n<script src=\"https://unpkg.com/@triiiceratops/plugin-image-manipulation/dist/iife.js\"></script>\n\n<triiiceratops-viewer\n    manifest-id=\"https://example.org/manifest.json\"\n    style=\"display: block; width: 100%; height: 100vh;\"\n></triiiceratops-viewer>\n\n<script>\n    customElements.whenDefined('triiiceratops-viewer').then(() => {\n        const viewer = document.querySelector('triiiceratops-viewer');\n        const plugin = window.Triiiceratops.plugins.get(\n            '@triiiceratops/plugin-image-manipulation',\n        );\n        viewer.plugins = [plugin];\n    });\n</script>"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "That snippet is the entire integration for a WordPress custom-HTML block, a Django or Rails template, or any page you can add a "
				},
				{
					"type": "text",
					"text": "<script>",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " tag to."
				}
			],
			"attrs": {
				"id": "03682d04-0fb2-48ad-8a4e-3d340c907f37"
			}
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Using a bundler instead? Register the element with "
				},
				{
					"type": "text",
					"text": "import 'triiiceratops/element/register'",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", then set properties directly — "
				},
				{
					"type": "text",
					"text": "document.querySelector('triiiceratops-viewer').manifestId = …",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " — no ref needed outside a component framework."
				}
			],
			"attrs": {
				"id": "fcb1ceae-55a8-4bf1-94ea-e860245ed84a"
			}
		},
		{
			"type": "bulletList",
			"content": [
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Loading the "
								},
								{
									"type": "text",
									"text": "same",
									"marks": [
										{
											"type": "bold"
										}
									]
								},
								{
									"type": "text",
									"text": " core version twice is a harmless no-op."
								}
							],
							"attrs": {
								"id": "fc68a0fb-f808-4017-aabe-15095262c6df"
							}
						}
					],
					"attrs": {
						"id": "392bdf59-c10b-4740-8ac0-a1115b9abf6b"
					}
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Loading a "
								},
								{
									"type": "text",
									"text": "different",
									"marks": [
										{
											"type": "bold"
										}
									]
								},
								{
									"type": "text",
									"text": " core version alongside one already registered leaves the first registration and custom element untouched and throws an actionable conflict error. Side-by-side multi-version loading on one page is not supported."
								}
							],
							"attrs": {
								"id": "bb785ef3-53d5-4098-8258-6a2b0ccb480e"
							}
						}
					],
					"attrs": {
						"id": "29476448-6b59-4903-828c-e390a53574a7"
					}
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Registering a plugin whose name is already registered keeps the first factory; a version mismatch is reported as a console warning (first-wins), not an error."
								}
							],
							"attrs": {
								"id": "e33a60c6-b4ea-4585-a30b-ddac60ffdd16"
							}
						}
					],
					"attrs": {
						"id": "4ec0993e-fd55-4f22-aa27-b5ded1d83d60"
					}
				}
			],
			"attrs": {
				"id": "8decd133-74d5-46f0-9046-4681c3e4d75a"
			}
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Runs under a strict CSP without "
				},
				{
					"type": "text",
					"text": "unsafe-eval",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " — see the "
				},
				{
					"type": "text",
					"text": "CSP recipe",
					"marks": [
						{
							"type": "link",
							"attrs": {
								"href": "/docs/csp/"
							}
						}
					]
				},
				{
					"type": "text",
					"text": "."
				}
			],
			"attrs": {
				"id": "7758ace1-6b46-482b-b081-0eed691f6da4"
			}
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "From there: "
				},
				{
					"type": "text",
					"text": "add plugins",
					"marks": [
						{
							"type": "link",
							"attrs": {
								"href": "/docs/plugins/"
							}
						}
					]
				},
				{
					"type": "text",
					"text": ", "
				},
				{
					"type": "text",
					"text": "configure the UI",
					"marks": [
						{
							"type": "link",
							"attrs": {
								"href": "/docs/configuration/"
							}
						}
					]
				},
				{
					"type": "text",
					"text": ", or "
				},
				{
					"type": "text",
					"text": "theme it",
					"marks": [
						{
							"type": "link",
							"attrs": {
								"href": "/docs/theming/"
							}
						}
					]
				},
				{
					"type": "text",
					"text": "."
				}
			],
			"attrs": {
				"id": "991c05f8-013f-4882-83ef-fe9895d8f481"
			}
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "driving-the-element-directly",
				"id": "724c9a21-f9a2-4939-97ae-603095eaf2ff"
			},
			"content": [
				{
					"type": "text",
					"text": "Driving the element directly"
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 3,
				"slug": "registering-the-element",
				"id": "733edb6b-09d4-46f8-8b17-b4da771b399c"
			},
			"content": [
				{
					"type": "text",
					"text": "Registering the element"
				}
