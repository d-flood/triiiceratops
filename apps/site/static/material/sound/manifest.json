    "label": {
        "en": ["Early recordings and Sousa marches"]
    },
    "summary": {
        "en": [
            "One of the earliest surviving sound recordings — a performance of Arthur Sullivan’s The Lost Chord on an Edison wax cylinder — and four of John Philip Sousa’s marches played by the United States Marine Band."
        ]
    },
    "metadata": [
        {
            "label": {
                "en": ["Source"]
            },
            "value": {
                "en": [
                    "Wikimedia Commons: the cylinder from the National Park Service (Thomas Edison National Historical Park) and the Internet Archive; the marches from the United States Marine Band; the portrait from the Library of Congress."
                ]
            }
        },
        {
            "label": {
                "en": ["Rights"]
            },
            "value": {
                "en": ["Public domain. Transcoded to MP3 for the web."]
            }
        },
        {
            "label": {
