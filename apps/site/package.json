{
    "name": "@triiiceratops/app-site",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "description": "The site published at the domain root: a SvelteKit application on the static adapter owning the whole tree — the marketing routes, the playground at /demo/ and the bare viewer at /viewer/ — with every route prerendered. Its build output is the whole published tree; it carries the framework consumer examples' build output, which is why it depends on that application without importing from it. A private workspace application; never published.",
    "license": "MIT",
    "author": "David Flood",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/d-flood/triiiceratops.git",
        "directory": "apps/site"
    },
    "scripts": {
        "predev": "node scripts/predev.mjs",
        "dev": "vite dev",
        "build": "vite build && node scripts/finish-build.mjs && node scripts/place-examples.mjs && node scripts/assert-no-editor-code.mjs",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
        "links:check": "node scripts/check-links.mjs",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix --max-warnings 0"
    },
    "dependencies": {
        "@triiiceratops/comparison": "workspace:*",
        "@triiiceratops/config": "workspace:*",
        "@triiiceratops/cookbook": "workspace:*",
        "@triiiceratops/plugin-annotation-editor": "workspace:*",
        "@triiiceratops/plugin-av": "workspace:*",
        "@triiiceratops/plugin-image-export": "workspace:*",
        "@triiiceratops/plugin-image-manipulation": "workspace:*",
        "@triiiceratops/plugin-pdf-export": "workspace:*",
        "@triiiceratops/shell": "workspace:*",
        "triiiceratops": "workspace:*",
        "uncial": "workspace:*"
    },
    "devDependencies": {
        "@playwright/test": "^1.57.0",
        "@sveltejs/adapter-static": "^3.0.9",
        "@sveltejs/kit": "^2.49.2",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@triiiceratops/app-examples": "workspace:*",
        "@triiiceratops/ui": "workspace:*",
        "@types/node": "^24.10.1",
        "eslint": "^9.39.2",
        "jsdom": "^27.3.0",
        "lighthouse": "^13.4.1",
        "pagefind": "^1.5.2",
        "svelte": "^5.56.10",
        "svelte-check": "^4.3.4",
        "typescript": "~5.9.3",
        "uncial-cms": "workspace:*",
        "vite": "^6.0.0",
        "vitest": "^4.0.15"
    }
}
