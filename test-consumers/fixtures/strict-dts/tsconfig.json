{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "verbatimModuleSyntax": false,
        // The whole point of this fixture: check the PUBLISHED declarations too
        // (`skipLibCheck: false`), so a strict consumer proves core's public
        // `.d.ts` stands on its own. `types: []` disables ambient
        // auto-inclusion, so anything core's declarations reach for that the
        // consumer has not installed is a compile error here rather than a
        // support issue later.
        "skipLibCheck": false,
        "types": []
    },
    "include": ["index.ts"]
}
