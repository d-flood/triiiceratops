{
    "name": "@triiiceratops/ui",
    "version": "0.0.0",
    "type": "module",
    "description": "Internal, unpublished themed UI primitives shared as Svelte source between the triiiceratops core viewer and its first-party plugins. Not published; bundled into each consumer at build time.",
    "license": "MIT",
    "author": "David Flood",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/d-flood/triiiceratops.git",
        "directory": "packages/ui"
    },
    "private": true,
    "sideEffects": false,
    "svelte": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "svelte": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./*.svelte": "./src/*.svelte",
        "./vite": "./vite.js"
    },
    "scripts": {
        "build": "pnpm clean && tsc -p tsconfig.build.json",
        "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.build.json --noEmit",
        "test": "vitest run --passWithNoTests",
        "test:coverage": "vitest run --coverage --passWithNoTests",
        "clean": "rm -rf dist",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix --max-warnings 0"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@vitest/coverage-v8": "4.0.15",
        "svelte": "5.56.10",
        "svelte-check": "^4.3.4",
        "typescript": "~5.9.3",
        "vite": "^6.0.0",
        "vitest": "^4.0.15"
    }
}
