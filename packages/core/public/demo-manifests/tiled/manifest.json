{
    "@context": "http://iiif.io/api/presentation/3/context.json",
    "id": "/demo-manifests/tiled/manifest.json",
    "type": "Manifest",
    "label": {
        "en": ["Tiled deep-zoom renderer fixture"]
    },
    "summary": {
        "en": [
            "A manifest whose canvases are backed by a IIIF Image API level 2 service with a real tile pyramid, served by the dev-server-only fake image service in scripts/iiifFixturePlugin.mjs. Both canvases paint the same numbered grid the static-image fixture uses, and their Canvas dimensions deliberately equal the image's pixel dimensions, so canvas space and image space coincide and the geometric assertions carry over unchanged at deep zoom. There are two canvases so that leaving one and returning to it can assert that image-service metadata is not refetched."
        ]
    },
    "items": [
        {
            "id": "/demo-manifests/tiled/canvas/one",
            "type": "Canvas",
            "label": { "en": ["Tiled grid one"] },
            "width": 1200,
            "height": 900,
            "items": [
                {
                    "id": "/demo-manifests/tiled/page/one",
                    "type": "AnnotationPage",
                    "items": [
                        {
                            "id": "/demo-manifests/tiled/annotation/one",
                            "type": "Annotation",
                            "motivation": "painting",
                            "body": {
                                "id": "/iiif-fixture/one/full/max/0/default.png",
                                "type": "Image",
                                "format": "image/png",
                                "width": 1200,
                                "height": 900,
                                "service": [
                                    {
                                        "id": "/iiif-fixture/one",
                                        "type": "ImageService3",
                                        "profile": "level2"
                                    }
                                ]
                            },
                            "target": "/demo-manifests/tiled/canvas/one"
                        }
                    ]
                }
            ]
        },
        {
            "id": "/demo-manifests/tiled/canvas/two",
            "type": "Canvas",
            "label": { "en": ["Tiled grid two"] },
            "width": 1200,
            "height": 900,
            "items": [
                {
                    "id": "/demo-manifests/tiled/page/two",
                    "type": "AnnotationPage",
                    "items": [
                        {
                            "id": "/demo-manifests/tiled/annotation/two",
                            "type": "Annotation",
                            "motivation": "painting",
                            "body": {
                                "id": "/iiif-fixture/two/full/max/0/default.png",
                                "type": "Image",
                                "format": "image/png",
                                "width": 1200,
                                "height": 900,
                                "service": [
                                    {
                                        "id": "/iiif-fixture/two",
                                        "type": "ImageService3",
                                        "profile": "level2"
                                    }
                                ]
                            },
                            "target": "/demo-manifests/tiled/canvas/two"
                        }
                    ]
                }
            ]
        }
    ]
}
