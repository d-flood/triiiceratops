{
    "@context": "http://iiif.io/api/presentation/3/context.json",
    "id": "/demo-manifests/level0-sizes/manifest.json",
    "type": "Manifest",
    "label": {
        "en": ["Level0 image service with sizes only"]
    },
    "summary": {
        "en": [
            "A manifest whose canvas is backed by a IIIF Image API level0 service that advertises only fixed whole-image sizes and no tiles at all — the size-ladder source. The fake service in scripts/iiifFixturePlugin.mjs answers 404 for any region other than 'full' and any size it did not advertise, so a renderer that tries to tile this canvas paints nothing. It shows the same numbered grid as the other renderer fixtures at Canvas dimensions equal to the image's pixel dimensions."
        ]
    },
    "items": [
        {
            "id": "/demo-manifests/level0-sizes/canvas/one",
            "type": "Canvas",
            "label": { "en": ["Level0 size-ladder grid"] },
            "width": 1200,
            "height": 900,
            "items": [
                {
                    "id": "/demo-manifests/level0-sizes/page/one",
                    "type": "AnnotationPage",
                    "items": [
                        {
                            "id": "/demo-manifests/level0-sizes/annotation/one",
                            "type": "Annotation",
                            "motivation": "painting",
                            "body": {
                                "id": "/iiif-fixture/l0-sizes-one/full/max/0/default.png",
                                "type": "Image",
                                "format": "image/png",
                                "width": 1200,
                                "height": 900,
                                "service": [
                                    {
                                        "id": "/iiif-fixture/l0-sizes-one",
                                        "type": "ImageService3",
                                        "profile": "level0"
                                    }
                                ]
                            },
                            "target": "/demo-manifests/level0-sizes/canvas/one"
                        }
                    ]
                }
            ]
        }
    ]
}
