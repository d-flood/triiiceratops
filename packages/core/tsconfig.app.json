{
    "extends": "@tsconfig/svelte/tsconfig.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "target": "es2022",
        "useDefineForClassFields": true,
        "module": "esnext",
        "types": ["svelte", "vite/client", "node"],
        "noEmit": true,

        // Strict public types (ticket 21). Inherited from @tsconfig/svelte, but
        // pinned explicitly here so EVERY package tsconfig states it with no
        // opt-outs and it can't silently regress if the base config changes.
        "strict": true,
        "noImplicitAny": true,

        "allowJs": true,
        "checkJs": true,
        "moduleDetection": "force",
        "composite": true
    },
    "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"],
    // These unit tests import standalone CLI scripts under scripts/ (each the
    // single source of truth for the logic it tests). Keep those scripts out of
    // this (composite, svelte-package) program — otherwise svelte-package emits
    // a stray scripts/*.d.ts beside them. vitest still runs both tests.
    "exclude": [
        "src/lib/theme/contrast.test.ts",
        "src/lib/cookbook/recipeDrift.test.ts"
    ]
}
