{
    "extends": "@tsconfig/svelte/tsconfig.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "target": "es2022",
        "useDefineForClassFields": true,
        "module": "esnext",
        "types": ["svelte", "vite/client", "node"],
        "noEmit": true,

        // Strict public types (ticket 21). Inherited from @tsconfig/svelte, but
        // pinned explicitly here so EVERY package tsconfig states it with no
        // opt-outs and it can't silently regress if the base config changes.
        "strict": true,
        "noImplicitAny": true,

        "allowJs": true,
        "checkJs": true,
        "moduleDetection": "force",
        "composite": true
    },
    "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"],
    // The contrast unit test imports the standalone CLI script under scripts/
    // (its single source of truth). Keep that script out of this (composite,
    // svelte-package) program — otherwise svelte-package emits a stray
    // scripts/*.d.ts. The script is type-checked via tsconfig.node.json instead;
    // vitest still runs this test.
    "exclude": ["src/lib/theme/contrast.test.ts"]
}
