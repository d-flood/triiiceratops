{
    "name": "@triiiceratops/cookbook",
    "version": "0.0.0",
    "type": "module",
    "description": "Internal, unpublished catalog of the IIIF Cookbook recipes and what Triiiceratops supports. Consumed as TypeScript source by the site application, the comparison package and the drift job; never shipped to a consumer.",
    "license": "MIT",
    "author": "David Flood",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/d-flood/triiiceratops.git",
        "directory": "packages/cookbook"
    },
    "private": true,
    "sideEffects": false,
    "types": "./src/recipes.ts",
    "exports": {
        ".": {
            "types": "./src/recipes.ts",
            "default": "./src/recipes.ts"
        }
    },
    "scripts": {
        "check": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix --max-warnings 0"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "4.0.15",
        "typescript": "~5.9.3",
        "vitest": "^4.0.15"
    }
}
