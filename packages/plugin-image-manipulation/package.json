{
    "name": "@triiiceratops/plugin-image-manipulation",
    "version": "1.0.0-rc.0",
    "type": "module",
    "description": "Image manipulation (CSS filters) plugin for the triiiceratops IIIF viewer, authored on @triiiceratops/plugin-sdk.",
    "license": "MIT",
    "author": "David Flood",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/d-flood/triiiceratops.git",
        "directory": "packages/plugin-image-manipulation"
    },
    "homepage": "https://d-flood.github.io/triiiceratops/",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "private": false,
    "sideEffects": [
        "./dist/iife.js"
    ],
    "files": [
        "dist"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./iife": "./dist/iife.js"
    },
    "scripts": {
        "build": "pnpm build:esm && pnpm build:iife && pnpm build:types",
        "build:esm": "BUILD_FORMAT=es vite build",
        "build:iife": "BUILD_FORMAT=iife vite build",
        "build:types": "tsc -p tsconfig.build.json",
        "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.build.json --noEmit",
        "test": "vitest run",
        "clean": "rm -rf dist"
    },
    "peerDependencies": {
        "triiiceratops": "workspace:*",
        "@triiiceratops/plugin-sdk": "workspace:*"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@triiiceratops/plugin-sdk": "workspace:*",
        "svelte": "5.45.5",
        "svelte-check": "^4.3.4",
        "triiiceratops": "workspace:*",
        "typescript": "~5.9.3",
        "vite": "^6.0.0",
        "vitest": "^4.0.15"
    }
}
