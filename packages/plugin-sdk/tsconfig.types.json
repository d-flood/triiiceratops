// Declaration-only pass. Mirrors tsconfig.build.json but keeps comments: the
// SDK's JSDoc is the plugin-authoring documentation, and `.d.ts` is where
// editors surface it. `removeComments` in the JS pass would strip it here too,
// which is why the two emits are separate.
{
    "extends": "./tsconfig.build.json",
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "removeComments": false,
        "sourceMap": false
    }
}
