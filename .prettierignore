# Root prettier ignore (ticket 37). `pnpm format:check` runs `prettier --check .`
# from the repo root, so these globs are matched workspace-wide with gitignore
# semantics (a bare `dir/` matches that directory at any depth). Keep this list
# aligned with the eslint ignores (eslint.config.js) and ticket 22's
# generated-code policy: formatting generated/vendored output creates permanent
# diff noise against the tools that produce it.

# Dependencies & lockfiles
node_modules/
pnpm-lock.yaml

# Build outputs (every package's dist/, the SvelteKit build dirs)
dist/
build/
.svelte-kit/
storybook-static/

# Generated code (ticket 22 generated-code policy; mirrors eslint ignores):
# the paraglide message runtime, generated icons/tokens, and the committed
# docs-example fixtures extracted from the site's content by
# scripts/docs-examples.mjs
# ("do not edit by hand"). Bare names match these dirs in every package.
paraglide/
generated/

# Generated API snapshots (scripts/api-report.ts) — regenerated & checked in CI.
api-reports/

# Uncial content documents (apps/site/content/*.json): the editor writes these
# back on every keystroke in its own normalized form, so anything this gate
# reflowed would be undone by the next edit and show up as a diff nobody made.
# Machine-written, on the same rule as the generated output above. The nested
# `content/docs/` is already covered by the bare `docs/` entry below.
apps/site/content/

# Vendored IIIF manifests (packages/core/src/lib/test/fixtures/manifests/*):
# third-party manifests copied from IIIF Cookbook recipes, public institutional
# endpoints, and manifesto.js's own test corpus, recorded in that directory's
# PROVENANCE.md. Same vendored-output rule as above — they are re-fetched from
# upstream, not authored here, and reflowing them destroys the diff against the
# source. The synthetic fixtures alongside them are TypeScript and stay
# formatted.
packages/core/src/lib/test/fixtures/manifests/

# The playground's vendored IIIF manifest, same rule: fetched from upstream
# rather than authored here.
apps/site/static/material/plate/manifest.json

# Generated e2e media (packages/core/tests/media/*): a tone, colour bars, an HLS
# rendition and real `audiowaveform` output, produced by that directory's
# `regenerate.sh`. Same generated-output rule. Beyond diff noise there is a hard
# reason: HLS segments are `.ts` files, which Prettier parses as TypeScript and
# chokes on. The local AV manifests beside them are hand-written fixtures, kept
# in the same house style as the vendored ones above.
packages/core/tests/media/

# Docs prose and hand-authored assets; eslint ignores docs/ as well. Not source
# files this gate should reflow.
docs/

# Changeset tooling state (managed by @changesets/cli — pre.json/config.json).
.changeset/

# Test, coverage, perf, and release output (mostly gitignored, but ignore here
# too so a local run doesn't trip the check on uncommitted artifacts).
coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/
perf-results/
release-artifacts/

# The Uncial submodule: a separate repository with its own Prettier config and
# its own format gate. Same vendored-output rule as above — reflowing it here
# would put every file permanently out of step with upstream.
vendor/

# Local tooling state / agent worktrees (nested full checkouts must never be format-gated)
.claude/
.opencode/
